# Server-side Jellyfin endpoint used by Next.js Route Handlers.
# Local development:
# http://127.0.0.1:8096
#
# Production later:
# https://jellyfin.lifeofpriya.com

JELLYFIN_SERVER_URL=

# Public Jellyfin endpoint used by the browser for direct artwork
# delivery and, later, direct media playback.
#
# Artwork and video bytes must NOT pass through Vercel.
#
# Local development:
# http://127.0.0.1:8096
#
# Production later:
# https://jellyfin.lifeofpriya.com
NEXT_PUBLIC_JELLYFIN_PUBLIC_URL=
