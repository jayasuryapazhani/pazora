# Server-side Jellyfin endpoint used by Next.js Route Handlers.
# Local development:
# http://127.0.0.1:8096
#
# Production later:
# https://jellyfin.lifeofpriya.com

JELLYFIN_SERVER_URL=

# Public Jellyfin endpoint used by the browser for direct artwork
# delivery and, later, direct media playback.
#
# Artwork and video bytes must NOT pass through Vercel.
#
# Local development:
# http://127.0.0.1:8096
#
# Production later:
# https://jellyfin.lifeofpriya.com
NEXT_PUBLIC_JELLYFIN_PUBLIC_URL=

# 32 random bytes encoded with base64url.
# Used only by the Pazora server to encrypt item-scoped playback grants.
# NEVER expose this through a NEXT_PUBLIC_ variable.
PAZORA_PLAYBACK_GRANT_SECRET=

# High-entropy shared secret used only between Caddy forward_auth
# and the private Pazora playback authorization endpoint.
PAZORA_PROXY_AUTH_SECRET=
